{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeglaNote",
  "version": "1.1.0",
  "identifier": "com.meglanote.notes",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MeglaNote",
        "width": 1000,
        "height": 700,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": [
          "**"
        ]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "meglanote"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDOEVCRkYyMDg1RTAxN0EKUldSNkFWNEk4citPek82Q3VHUUdVcUV3Yk1Ndmgxb2VURFNZL3czN2NGbGlrVitNQnk2TUlhYVIK",
      "endpoints": [
        "https://github.com/johnt105/meglanote/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "app"
    ],
    "category": "Productivity",
    "icon": [
      "icons/icon.icns",
      "icons/icon.png"
    ],
    "createUpdaterArtifacts": true
  }
}
