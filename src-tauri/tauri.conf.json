{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MeglaNote",
  "version": "1.0.0",
  "identifier": "com.meglanote.notes",
  "build": {
    "frontendDist": "../renderer"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "MeglaNote",
        "width": 1000,
        "height": 700,
        "minWidth": 480,
        "minHeight": 400
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["meglanote"]
      }
    },
    "updater": {
      "pubkey": "REPLACE_WITH_PUBLIC_KEY_FROM_tauri_signer_generate",
      "endpoints": [
        "https://github.com/REPLACE_WITH_GITHUB_USERNAME/meglanote/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["dmg", "app"],
    "category": "Productivity",
    "icon": ["icons/icon.icns", "icons/icon.png"],
    "createUpdaterArtifacts": true
  }
}
